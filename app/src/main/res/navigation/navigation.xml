<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/titleFragment">

    <fragment
        android:id="@+id/titleFragment"
        android:name="dam.jesuitas.android_entrega6.titleFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_title" >
        <action
            android:id="@+id/action_titleFragment_to_listFragment"
            app:destination="@id/listFragment" />
    </fragment>
    <fragment
        android:id="@+id/listFragment"
        android:name="dam.jesuitas.android_entrega6.listFragment"
        android:label="@string/movie_list"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="dam.jesuitas.android_entrega6.detailFragment"
        android:label="@string/movie_detail"
        tools:layout="@layout/fragment_detail" >
        <argument
            android:name="image"
            app:argType="integer" />
        <argument
            android:name="actors"
            app:argType="string[]" />
        <argument
            android:name="title"
            app:argType="integer" />
        <argument
            android:name="genre"
            app:argType="integer" />
        <argument
            android:name="year"
            app:argType="integer" />
        <argument
            android:name="director"
            app:argType="integer" />
    </fragment>
</navigation>