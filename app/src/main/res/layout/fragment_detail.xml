<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/action_image"
            android:layout_width="374dp"
            android:layout_height="386dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.489"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewActors"
            android:layout_width="182dp"
            android:layout_height="189dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="84dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.344"
            app:layout_constraintStart_toEndOf="@+id/textViewDirector"
            app:layout_constraintTop_toBottomOf="@+id/action_image"
            app:layout_constraintVertical_bias="0.15" />

        <TextView
            android:id="@+id/textViewGenre"
            android:layout_width="116dp"
            android:layout_height="36dp"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewYear"
            app:layout_constraintVertical_bias="0.998" />

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="24dp"
            android:layout_height="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="4dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewYear"
            android:layout_width="35dp"
            android:layout_height="24dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/textViewTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textViewTitle" />

        <TextView
            android:id="@+id/textViewDirector"
            android:layout_width="128dp"
            android:layout_height="37dp"
            android:layout_marginStart="32dp"
            app:layout_constraintBottom_toTopOf="@+id/textViewGenre"
            app:layout_constraintEnd_toEndOf="@+id/textViewGenre"
            app:layout_constraintHorizontal_bias="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textConcat"
            app:layout_constraintVertical_bias="0.447" />

        <TextView
            android:id="@+id/textConcat"
            android:layout_width="306dp"
            android:layout_height="40dp"
            android:autoSizeTextType="uniform"
            android:textStyle="bold|normal"
            app:layout_constraintBottom_toTopOf="@+id/textViewActors"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_image"
            app:layout_constraintVertical_bias="0.346" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>